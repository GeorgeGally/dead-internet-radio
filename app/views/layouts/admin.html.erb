<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DIR Control</title>
  <%= csrf_meta_tags %>
  <%= render "layouts/icons" %>
  <link rel="stylesheet" href="<%= hashed_public_path "/admin.css" %>">
  <script src="<%= hashed_public_path "/admin-player.js" %>" defer></script>
</head>
<body>
  <nav>
    <h1>DIR Control</h1>
    <a href="/admin">Dashboard</a>
    <a href="/admin/schedule">Schedule</a>
    <a href="/admin/shows">Shows</a>
    <a href="/admin/library">Library</a>
    <% outstanding_requests = SongRequest.outstanding.count %>
    <a href="/admin/requests">Requests<% if outstanding_requests.positive? %><span class="nav-count"><%= outstanding_requests %></span><% end %></a>
    <a href="/admin/transmissions">Signal</a>
    <a href="/admin/visuals">Visuals</a>
    <a href="/admin/idents">Station IDs</a>
    <a href="/admin/generation">Generate</a>
    <div style="flex:1"></div>
    <%= link_to "Sign out", admin_logout_path, method: :delete, style: "font-size:12px;color:rgba(216,212,203,0.25);margin-top:auto" %>
  </nav>
  <main>
    <% if notice %>
      <div class="flash notice"><%= notice %></div>
    <% end %>
    <% if alert %>
      <div class="flash notice"><%= alert %></div>
    <% end %>
    <%= yield %>
  </main>
  <script>
    // Like / dislike keys: press to vote, press the lit key again to take it back.
    document.addEventListener('click', function(e) {
      var btn = e.target.closest('[data-like]');
      if (!btn) return;
      var value = Number(btn.dataset.value), lit = btn.classList.contains('liked') || btn.classList.contains('disliked');
      fetch(btn.dataset.like, {
        method: 'POST', credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': document.querySelector('meta[name=csrf-token]').content },
        body: JSON.stringify({ value: lit ? 0 : value }),
      }).then(function(r) { return r.ok ? r.json() : null; }).then(function(v) {
        if (!v) return;
        var cell = btn.closest('.like-cell') || btn.parentElement.parentElement;
        cell.querySelector('[data-value="1"]').classList.toggle('liked', v.mine === 1);
        cell.querySelector('[data-value="-1"]').classList.toggle('disliked', v.mine === -1);
        cell.querySelector('.vote-up').textContent = '+' + v.up;
        cell.querySelector('.vote-down').textContent = '\u2212' + v.down;
      });
    });

    // Times arrive in UTC; show them in this browser's zone.
    document.querySelectorAll('time[data-local]').forEach(function(t) {
      var d = new Date(t.getAttribute('datetime')), pad = function(n) { return String(n).padStart(2, '0'); };
      var clock = pad(d.getHours()) + ':' + pad(d.getMinutes());
      t.textContent = t.dataset.local === 'time' ? clock
        : d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + ' ' + clock;
    });
  </script>
</body>
</html>
