<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DIR Control</title>
  <%= csrf_meta_tags %>
  <link rel="stylesheet" href="/admin.css">
  <script src="/admin-player.js" defer></script>
</head>
<body>
  <nav>
    <h1>DIR Control</h1>
    <a href="/admin">Dashboard</a>
    <a href="/admin/schedule">Schedule</a>
    <a href="/admin/shows">Shows</a>
    <a href="/admin/library">Library</a>
    <a href="/admin/requests">Requests</a>
    <a href="/admin/visuals">Visuals</a>
    <a href="/admin/generation">Generate</a>
    <div style="flex:1"></div>
    <%= link_to "Sign out", admin_logout_path, method: :delete, style: "font-size:12px;color:rgba(216,212,203,0.25);margin-top:auto" %>
  </nav>
  <main>
    <% if notice %>
      <div class="flash notice"><%= notice %></div>
    <% end %>
    <%= yield %>
  </main>
  <script>
    // Like keys: press to like a song, press again to take it back.
    document.addEventListener('click', function(e) {
      var btn = e.target.closest('[data-like]');
      if (!btn) return;
      var liked = btn.classList.contains('liked');
      fetch(btn.dataset.like, {
        method: 'POST', credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': document.querySelector('meta[name=csrf-token]').content },
        body: JSON.stringify({ value: liked ? 0 : 1 }),
      }).then(function(r) { return r.ok ? r.json() : null; }).then(function(v) {
        if (!v) return;
        btn.classList.toggle('liked', v.mine === 1);
        var box = btn.parentElement.querySelector('[data-votes]');
        box.querySelector('.vote-up').textContent = '+' + v.up;
        box.querySelector('.vote-down').textContent = '\u2212' + v.down;
      });
    });

    // Times arrive in UTC; show them in this browser's zone.
    document.querySelectorAll('time[data-local]').forEach(function(t) {
      var d = new Date(t.getAttribute('datetime')), pad = function(n) { return String(n).padStart(2, '0'); };
      var clock = pad(d.getHours()) + ':' + pad(d.getMinutes());
      t.textContent = t.dataset.local === 'time' ? clock
        : d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + ' ' + clock;
    });
  </script>
</body>
</html>
