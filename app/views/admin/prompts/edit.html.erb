<div class="prompts-page">
  <div class="prompts-head">
    <h2><%= link_to MasterPrompt.label(@prompt.kind), admin_prompts_path(kind: @prompt.kind), class: "prompts-back" %> / <%= @prompt.name_was %></h2>
    <% if @prompt.active? %><span class="prompt-on">In use</span><% end %>
  </div>
  <p class="prompt-meta prompt-meta-head">v<%= @prompt.version %> · <time datetime="<%= @prompt.updated_at.utc.iso8601 %>" data-local="datetime"><%= @prompt.updated_at.utc.strftime("%Y-%m-%d %H:%M") %></time></p>

  <%= render "form", prompt: @prompt %>

  <div class="prompt-more">
    <%= button_to "Duplicate", duplicate_admin_prompt_path(@prompt), class: "btn-key", form_class: "inline-form" %>
    <% unless @prompt.active? %>
      <%= button_to "Delete", admin_prompt_path(@prompt), method: :delete, class: "btn-quiet", form_class: "inline-form" %>
    <% end %>
  </div>
</div>
