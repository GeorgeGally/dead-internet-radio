<h2>Schedule</h2>

<% if @blocks.empty? %>
  <p class="meta">Nothing booked. The station needs a finished show or set to play.</p>
<% end %>

<% @blocks.each_with_index do |segs, i| %>
  <% show = segs.first.track.show %>
  <section class="sched-block<%= ' sched-now' if i.zero? %>">
    <div class="sched-head">
      <span class="sched-time"><%= local_time(segs.first.starts_at, format: "time") %></span>
      <a href="<%= admin_show_path(show) %>"><%= show.name || show.slot %></a>
      <% if show.dj_name.present? %><span class="sched-dj">DJ <%= show.dj_name %></span><% end %>
      <span class="meta"><%= show.kind %> · <%= mmss(segs.sum { |s| s.ends_at - s.starts_at }) %></span>
      <% if i.zero? %><span class="sched-on">on air</span><% end %>
    </div>
    <table>
      <% segs.each do |seg| %>
        <% t = seg.track %>
        <% playing = seg.starts_at <= @now && seg.ends_at > @now %>
        <tr class="<%= 'sched-playing' if playing %>">
          <td class="play-cell">
            <% if t.audio_path && File.exist?(t.audio_path) %>
              <button type="button" class="btn-play" data-src="<%= media_track_path(t) %>" onclick="playTrack(this)" aria-label="Play">▶</button>
            <% end %>
          </td>
          <td class="sched-time"><%= local_time(seg.starts_at, format: "time") %></td>
          <td data-scrub><%= t.song.votable? ? link_to(t.title, admin_track_path(t)) : t.title %></td>
          <td><%= t.artist == Track::STATION_ARTIST && show.dj_name.present? ? "DJ #{show.dj_name}" : artist_link(t.artist) %></td>
          <td>
            <% if (req = @requests[t.song_id]) %>
              <span class="sched-req">request · <%= req.user.first_name %></span>
            <% end %>
          </td>
          <td class="sched-plays"><%= pluralize(@plays[t.song_id].to_i, "play") if t.song.votable? %></td>
          <td class="like-cell"><%= render "admin/tracks/like", song: t.song, mine: @mine[t.song_id] %></td>
          <td class="sched-len"><%= mmss(seg.ends_at - seg.starts_at) %></td>
        </tr>
      <% end %>
    </table>
  </section>
<% end %>
