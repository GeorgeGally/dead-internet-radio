<h2><%= @show.name || @show.slot %></h2>

<p class="meta">
  Slot: <%= @show.slot %>
  &middot; DJ: <%= @show.dj_name %>
  &middot; Tracks: <%= @show.track_count %>
  &middot; Status: <span class="status-badge status-<%= @show.status %>"><%= @show.status %></span>
  <% if @show.mix_file %>&middot; Mix: ready<% end %>
</p>

<% if @master_prompts.present? %>
  <p class="meta">Prompts: <%= MasterPrompt.describe(@master_prompts) %></p>
<% end %>

<% if @show.mix_path && File.exist?(@show.mix_path) %>
  <p class="now-playing" style="font-size:15px;margin:0 0 12px;">
    <strong style="color:#c03f0d;">Now playing</strong>
    <span data-now-playing>Press play to start the mix</span>
  </p>
  <audio class="show-mix" controls preload="none" src="<%= media_show_mix_path(@show) %>"></audio>
<% end %>

<% if @reedit_batch.any? || @reedit_failed %>
  <div class="track-job-loader<%= " track-job-failed" if @reedit_failed %>" role="status" aria-live="polite"
       data-progress="<%= reedit_progress_admin_show_path(@show) %>"
       data-kind="rerender" data-since="<%= @reedit_batch.first&.created_at&.iso8601 %>">
    <div class="loader-bar<%= " loader-sweep" unless @reedit_failed %>"><div class="loader-fill js-track-job-fill"></div></div>
    <p class="loader-line">
      <span class="loader-stage js-track-job-stage"><%= @reedit_failed ? "The re-edit failed" : "Editing the show…" %></span>
      <span class="loader-clock js-track-job-clock">0:00</span>
    </p>
  </div>
<% elsif @reedit_remix %>
  <%= render "admin/shared/track_job_loader", job: @reedit_remix %>
<% end %>

<div style="margin:16px 0 6px;">
  <%= form_tag reedit_admin_show_path(@show), class: "rerender-form" do %>
    <input type="text" name="instructions" class="rerender-notes" maxlength="400" autocomplete="off"
           placeholder="What to change across the whole mix: darker, slower, more space…">
    <button type="submit" class="btn-key btn-key-go">Re-edit whole mix</button>
  <% end %>
</div>

<p style="margin:0 0 16px;">
  <%= button_to "Remix", remix_admin_show_path(@show), method: :post, class: "btn", style: "display:inline;margin-right:8px;", data: { confirm: "Re-run djmix.py on this show?" } %>
  <%= button_to "Re‑import", reimport_admin_show_path(@show), method: :post, class: "btn", style: "display:inline;margin-right:8px;", data: { confirm: "Re-read filesystem data into DB?" } %>
  <%= button_to "Delete", admin_show_path(@show), method: :delete, class: "btn", style: "display:inline;background:#cc0000;", data: { confirm: "Delete this show?" } %>
</p>

<% if @show.directory %>
  <p class="meta">Directory: <code><%= @show.directory %></code></p>
<% end %>

<%= render "admin/shows/tracks", show: @show, tracks: @tracks, mine: @mine %>
