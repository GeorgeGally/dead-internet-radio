<h2><%= @show.name || @show.slot %></h2>

<p class="meta">
  Slot: <%= @show.slot %>
  &middot; DJ: <%= @show.dj_name %>
  &middot; Tracks: <%= @show.track_count %>
  &middot; Status: <span class="status-badge status-<%= @show.status %>"><%= @show.status %></span>
  <% if @show.mix_file %>&middot; Mix: ready<% end %>
</p>

<%= render "admin/shows/player", sources: @player_sources %>

<div class="show-actions">
  <%= button_to "Remix", remix_admin_show_path(@show), method: :post, class: "btn", data: { confirm: "Re-run djmix.py on this show?" } %>
  <%= button_to "Re‑import", reimport_admin_show_path(@show), method: :post, class: "btn", data: { confirm: "Re-read filesystem data into DB?" } %>
  <%= button_to "Delete", admin_show_path(@show), method: :delete, class: "btn", style: "background:#cc0000;", data: { confirm: "Delete this show?" } %>
</div>

<% if @show.directory %>
  <p class="meta">Directory: <code><%= @show.directory %></code></p>
<% end %>

<%= render "admin/shows/tracks", show: @show, tracks: @tracks, mine: @mine %>
