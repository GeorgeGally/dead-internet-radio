<h2><%= @show.name || @show.slot %></h2>

<p class="meta">
  Slot: <%= @show.slot %>
  &middot; DJ: <%= @show.dj_name %>
  &middot; Tracks: <%= @show.track_count %>
  &middot; Status: <span class="status-badge status-<%= @show.status %>"><%= @show.status %></span>
  <% if @show.mix_file %>&middot; Mix: ready<% end %>
</p>

<% if @show.mix_path && File.exist?(@show.mix_path) %>
  <audio class="show-mix" controls preload="none" src="<%= media_show_mix_path(@show) %>"></audio>
<% end %>

<p style="margin:16px 0;">
  <%= button_to "Remix", remix_admin_show_path(@show), method: :post, class: "btn", style: "display:inline;margin-right:8px;", data: { confirm: "Re-run djmix.py on this show?" } %>
  <%= button_to "Re‑import", reimport_admin_show_path(@show), method: :post, class: "btn", style: "display:inline;margin-right:8px;", data: { confirm: "Re-read filesystem data into DB?" } %>
  <%= button_to "Delete", admin_show_path(@show), method: :delete, class: "btn", style: "display:inline;background:#cc0000;", data: { confirm: "Delete this show?" } %>
</p>

<% if @show.directory %>
  <p class="meta">Directory: <code><%= @show.directory %></code></p>
<% end %>

<table>
  <tr>
    <th>#</th>
    <th>Title</th>
    <th>Artist</th>
    <th>BPM</th>
    <th>Key</th>
    <th>Duration</th>
    <th>Mix-in</th>
    <th></th>
  </tr>
  <% @tracks.each do |track| %>
    <tr>
      <td>
        <% if track.audio_path && File.exist?(track.audio_path) %>
          <button type="button" class="btn-play" data-src="<%= media_track_path(track) %>" onclick="playTrack(this)" aria-label="Play">▶</button>
        <% else %>
          <%= track.position %>
        <% end %>
      </td>
      <td><%= track.title %></td>
      <td><%= track.artist %></td>
      <td><%= track.bpm %></td>
      <td><%= track.key %></td>
      <td><%= mmss(track.duration_ms && track.duration_ms / 1000.0) %></td>
      <td><%= track.cue_seconds ? mmss(track.cue_seconds) : "—" %></td>
      <td class="track-actions">
        <% if track.song.votable? %>
          <button type="button" class="btn-key" onclick="openRerender(this)">Re-render</button>
        <% end %>
        <%= button_to "Remove", admin_track_path(track), method: :delete, class: "btn-quiet", form: { style: "display:inline" }, data: { confirm: "Remove '#{track.title}' from this show? You'll need to click Remix to rebuild the mix." } %>
      </td>
    </tr>
    <tr class="rerender-row" hidden>
      <td></td>
      <td colspan="7">
        <%= form_tag rerender_admin_track_path(track), class: "rerender-form" do %>
          <input type="text" name="instructions" class="rerender-notes" maxlength="400" autocomplete="off"
                 placeholder="What to change: slower, darker bass, no hi-hats, more space…">
          <button type="submit" class="btn-key btn-key-go">Render</button>
        <% end %>
      </td>
    </tr>
  <% end %>
</table>

<script>
  // One player for the table: a row's key plays it, pressing again stops.
  // The playing row gets a bar under its title to click or drag through.
  var trackAudio = new Audio();
  var scrub = document.createElement('div');
  scrub.className = 'scrub';
  scrub.innerHTML = '<div class="scrub-bar"><div class="scrub-fill"></div></div><span class="scrub-time"></span>';
  var fill = scrub.querySelector('.scrub-fill'), time = scrub.querySelector('.scrub-time');

  function fmt(t) { t = Math.floor(t || 0); return Math.floor(t / 60) + ':' + String(t % 60).padStart(2, '0'); }
  trackAudio.addEventListener('timeupdate', function() {
    var d = trackAudio.duration || 0;
    fill.style.width = d ? (trackAudio.currentTime / d * 100) + '%' : '0';
    time.textContent = fmt(trackAudio.currentTime) + ' / ' + fmt(d);
  });

  var bar = scrub.querySelector('.scrub-bar');
  function seek(e) {
    var r = bar.getBoundingClientRect();
    if (trackAudio.duration) trackAudio.currentTime = Math.min(Math.max((e.clientX - r.left) / r.width, 0), 1) * trackAudio.duration;
  }
  bar.addEventListener('pointerdown', function(e) { bar.setPointerCapture(e.pointerId); seek(e); });
  bar.addEventListener('pointermove', function(e) { if (e.buttons) seek(e); });

  function stopAll() {
    document.querySelectorAll('.btn-play').forEach(function(b) { b.classList.remove('playing'); b.textContent = '\u25B6'; });
    scrub.remove();
  }
  function playTrack(btn) {
    var playing = btn.classList.contains('playing');
    stopAll();
    document.querySelectorAll('audio.show-mix').forEach(function(a) { a.pause(); });
    if (playing) { trackAudio.pause(); return; }
    trackAudio.src = btn.dataset.src;
    trackAudio.play();
    btn.classList.add('playing');
    btn.textContent = '\u25A0';
    fill.style.width = '0';
    time.textContent = '';
    btn.closest('tr').children[1].appendChild(scrub);
  }
  trackAudio.addEventListener('ended', stopAll);

  // Re-render opens a notes field under its track.
  function openRerender(btn) {
    var row = btn.closest('tr').nextElementSibling;
    row.hidden = !row.hidden;
    if (!row.hidden) row.querySelector('input').focus();
  }
</script>
