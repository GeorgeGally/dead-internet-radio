<table class="songs">
  <tr>
    <th>#</th>
    <th>Title</th>
    <th>Artist</th>
    <th>BPM</th>
    <th>Key</th>
    <th>Duration</th>
    <th>Mix-in</th>
    <th>Votes</th>
    <th></th>
  </tr>
  <% tracks.each do |track| %>
    <tr data-track="<%= track.id %>" data-cue="<%= track.cue_seconds %>" data-ms="<%= track.duration_ms %>" data-now="<%= "#{track.artist} — #{track.title}" %>">
      <td>
        <% if track.audio_path && File.exist?(track.audio_path) %>
          <button type="button" class="btn-play" data-src="<%= media_track_path(track) %>" onclick="playTrack(this)" aria-label="Play">▶</button>
        <% else %>
          <%= track.position %>
        <% end %>
      </td>
      <td data-scrub><%= track.song.votable? ? link_to(track.title, admin_track_path(track)) : track.title %></td>
      <td><%= artist_link(track.artist) %></td>
      <td><%= track.bpm %></td>
      <td><%= track.key %></td>
      <td><%= mmss(track.duration_ms && track.duration_ms / 1000.0) %></td>
      <td><%= track.cue_seconds ? mmss(track.cue_seconds) : "—" %></td>
      <td class="like-cell"><%= render "admin/tracks/like", song: track.song, mine: mine[track.song_id] %></td>
      <td class="track-actions">
        <% if track.origin_track_id && show.kind == "set" %>
          <button type="button" class="btn-key" onclick="openSwap(this)" data-options="<%= swap_options_admin_track_path(track) %>">Swap</button>
        <% end %>
        <% if track.song.votable? %>
          <button type="button" class="btn-key"
                  data-edit-url="<%= rerender_admin_track_path(track) %>"
                  data-remix-url="<%= remix_admin_track_path(track) %>"
                  onclick="openNotes(this, 'edit')">Edit</button>
          <% if track.song.prompt_log["payload"].present? %>
            <button type="button" class="btn-key"
                    data-edit-url="<%= rerender_admin_track_path(track) %>"
                    data-remix-url="<%= remix_admin_track_path(track) %>"
                    onclick="openNotes(this, 'remix')">Remix</button>
          <% end %>
        <% end %>
        <% if track.audio_path && File.exist?(track.audio_path) %>
          <%= link_to "Download", download_media_track_path(track), class: "btn-key", data: { turbo: false } %>
        <% end %>
        <%= button_to "Remove", admin_track_path(track), method: :delete, class: "btn-quiet", form: { style: "display:inline" }, data: { confirm: "Remove '#{track.title}' from this show? You'll need to click Remix to rebuild the mix." } %>
      </td>
    </tr>
    <% if (job = pending_track_job_for(track.song)) %>
    <tr class="track-job-row">
      <td></td>
      <td colspan="8"><%= render "admin/shared/track_job_loader", job: job, compact: true %></td>
    </tr>
    <% end %>
    <tr class="swap-row" hidden>
      <td></td>
      <td colspan="8">
        <input type="search" class="rerender-notes swap-search" placeholder="Search the library…" autocomplete="off">
        <div class="swap-results"></div>
      </td>
    </tr>
    <tr class="notes-row" hidden
        data-edit-hint="<%= Admin::TrackJobsHelper::EDIT_HINT %>"
        data-remix-hint="<%= Admin::TrackJobsHelper::REMIX_HINT %>">
      <td></td>
      <td colspan="8">
        <%# JS swaps the action to remix, so the token must not be tied to this URL. %>
        <%= form_tag rerender_admin_track_path(track), class: "rerender-form notes-form", authenticity_token: form_authenticity_token do %>
          <%= hidden_field_tag :back, request.path %>
          <input type="text" name="instructions" class="rerender-notes" maxlength="400" autocomplete="off"
                 placeholder="What to change: slower, darker bass, no hi-hats, more space…">
          <button type="submit" class="btn-key btn-key-go notes-submit">Edit</button>
        <% end %>
        <p class="action-hint meta notes-hint"><%= Admin::TrackJobsHelper::EDIT_HINT %></p>
      </td>
    </tr>
  <% end %>
</table>

