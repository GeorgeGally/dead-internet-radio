<%# Listener votes on a song and the station's like key. %>
<% if song.votable? %>
  <span class="votes" data-votes><span class="vote-up">+<%= song.up_votes %></span> <span class="vote-down">&minus;<%= song.down_votes %></span></span>
  <button type="button" class="btn-like<%= ' liked' if mine == 1 %>" data-like="<%= like_admin_track_path(song) %>" aria-label="Like" title="Like"><svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M12 21s-7.5-4.6-9.6-9.2C.9 8.4 3 4.5 6.7 4.5c2.1 0 3.6 1.2 5.3 3.1 1.7-1.9 3.2-3.1 5.3-3.1 3.7 0 5.8 3.9 4.3 7.3C19.5 16.4 12 21 12 21z" fill="currentColor"/></svg></button>
<% end %>
