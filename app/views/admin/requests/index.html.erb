<h2>Requests</h2>

<table class="requests">
  <tr><th></th><th>When</th><th>From</th><th>Title</th><th>Artist</th><th>Note</th><th>Status</th><th>Airs</th><th>Reason</th><th>Sounds like</th><th></th></tr>
  <% @requests.each do |req| %>
    <% song = req.track %>
    <% notes = song && (song.prompt_log.dig("rerender", "notes") || req.note) %>
    <% playable = song && song.audio_path && File.exist?(song.audio_path) %>
    <% job = @render_jobs[req.id] || (song && @pending_song_jobs[song.id]) %>
    <tr id="request-<%= req.id %>">
      <td class="play-cell">
        <% if playable %>
          <button type="button" class="btn-play" data-src="<%= media_track_path(song) %>" onclick="playTrack(this)" aria-label="Play">▶</button>
        <% end %>
      </td>
      <td><%= local_time(req.created_at) %></td>
      <td title="<%= req.user.email %>"><%= req.user.name %></td>
      <td data-scrub><%= song ? link_to(req.title, admin_track_path(song)) : req.title %></td>
      <td><%= song ? artist_link(req.artist) : req.artist %></td>
      <td><%= req.note %></td>
      <td>
        <%= render "admin/requests/status", req: req, seg: req.track_id && @airs[req.track_id], aired: req.track_id && @aired[req.track_id] %>
        <% if job %>
          <%= render "admin/shared/track_job_loader", job: job, compact: true %>
        <% end %>
      </td>
      <td><% if (seg = req.track_id && @airs[req.track_id]) %><%= link_to local_time(seg.starts_at), admin_schedule_path(anchor: "seg-#{seg.id}") %><% elsif (seg = req.track_id && @aired[req.track_id]) %><span class="meta" title="Aired"><%= local_time(seg.starts_at) %></span><% elsif req.ready? %>next set<% end %></td>
      <td><%= req.rejection_reason %></td>
      <td><%= req.matched_track && "#{req.matched_track.artist} — #{req.matched_track.title}" %></td>
      <td class="track-actions">
        <% if song %>
          <% if playable %><%= link_to "Download", download_media_track_path(song), class: "btn-key" %><% end %>
          <button type="button" class="btn-key" data-notes="<%= notes %>"
                  data-edit-url="<%= rerender_admin_track_path(song) %>"
                  data-remix-url="<%= remix_admin_track_path(song) %>"
                  onclick="openNotes(this, 'edit')">Edit</button>
          <button type="button" class="btn-key"
                  data-edit-url="<%= rerender_admin_track_path(song) %>"
                  data-remix-url="<%= remix_admin_track_path(song) %>"
                  onclick="openNotes(this, 'remix')">Remix</button>
        <% end %>
        <%= button_to "Render", fulfill_admin_request_path(req), class: "btn" if req.accepted? && !Rails.env.production? %>
        <%= button_to "Retry", retry_admin_request_path(req), class: "btn" if req.failed? %>
      </td>
    </tr>
    <% if (takes = @song_takes[song&.id]) %>
      <tr class="takes-row">
        <td></td>
        <td colspan="10">
          <strong class="meta">Remixes and edits</strong>
          <ol class="sp-takes">
            <% takes.each do |take| %>
              <% take_song = take.song %>
              <li>
                <% if take.audio_path&.exist? %>
                  <% src = take.rerender? ? media_track_replaced_path(take_song, take.replaced_stamp) : media_track_path(take_song) %>
                  <button type="button" class="btn-play" data-src="<%= src %>" onclick="playTrack(this)" aria-label="Play">▶</button>
                <% else %>
                  <span class="btn-play-gap"></span>
                <% end %>
                <span class="sp-take"><%= take.label %><% if take.notes.present? %><span class="sp-notes"><%= take.notes %></span><% end %></span>
                <% if take_song.nil? && take.job&.live? %><%= render "admin/shared/track_job_loader", job: take.job, compact: true %><% end %>
              </li>
            <% end %>
          </ol>
        </td>
      </tr>
    <% end %>
    <% if song %>
      <tr class="notes-row" hidden
          data-edit-hint="<%= Admin::TrackJobsHelper::EDIT_HINT %>"
          data-remix-hint="<%= Admin::TrackJobsHelper::REMIX_HINT %>">
        <td></td>
        <td colspan="10">
          <%# JS swaps the action to remix, so the token must not be tied to this URL. %>
          <%= form_tag rerender_admin_track_path(song), class: "rerender-form notes-form", authenticity_token: form_authenticity_token do %>
            <input type="hidden" name="request_id" value="<%= req.id %>">
            <input type="hidden" name="inline" value="1">
            <input type="text" name="instructions" class="rerender-notes" maxlength="400" autocomplete="off"
                   placeholder="How should it change? Slower, darker bass, more space…">
            <button type="submit" class="btn-key btn-key-go notes-submit">Edit</button>
          <% end %>
          <p class="action-hint meta notes-hint"><%= Admin::TrackJobsHelper::EDIT_HINT %></p>
        </td>
      </tr>
    <% end %>
  <% end %>
</table>