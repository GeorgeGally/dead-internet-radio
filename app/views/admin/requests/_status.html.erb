<%# A request's status badge; once booked it opens the Schedule at its slot, once played it says when. %>
<% if seg %>
  <%= link_to req.status, admin_schedule_path(anchor: "seg-#{seg.id}"), class: "status-badge status-#{req.status}", title: "Airs #{seg.starts_at.utc.iso8601}" %>
<% elsif local_assigns[:aired] %>
  <span class="status-badge status-<%= req.status %>" title="Aired <%= aired.starts_at.utc.iso8601 %>"><%= req.status %></span>
<% else %>
  <span class="status-badge status-<%= req.status %>"><%= req.status %></span>
<% end %>
