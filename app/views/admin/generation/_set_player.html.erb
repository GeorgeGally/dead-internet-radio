<%# The mix, the song it is on now and that song's takes: hear each one, use one in the set (the mix is made again with it), or ask for a new remix. %>
<div class="set-player" data-set-player>
  <audio class="show-mix" controls preload="none" src="<%= media_show_mix_path(show) %>"></audio>
  <% tracks.each do |track| %>
    <div class="sp-song" data-track="<%= track.id %>" hidden>
      <p class="sp-now"><span class="sp-pos"><%= format("%02d", track.position) %></span> <span class="sp-name"><%= track.artist %> — <%= track.title %></span></p>
      <% if track.song.idea.present? %><p class="sp-idea"><%= track.song.idea %></p><% end %>
      <% if track.song.votable? %>
        <ol class="sp-takes">
          <% SongTakes.for(track.song).each do |take| %>
            <% song = take.song %>
            <li class="<%= 'in-set' if take.in_set?(track) %>">
              <% if take.audio_path&.exist? %>
                <% src = take.rerender? ? media_track_replaced_path(song, take.replaced_stamp) : media_track_path(song) %>
                <button type="button" class="btn-play" data-src="<%= src %>" onclick="playTrack(this)" aria-label="Play">▶</button>
              <% else %>
                <span class="btn-play-gap"></span>
              <% end %>
              <span class="sp-take" data-scrub>
                <%= take.label %><% if take.notes.present? %><span class="sp-notes"><%= take.notes %></span><% end %>
              </span>
              <% if song.nil? && take.job.live? %>
                <%= render "admin/shared/track_job_loader", job: take.job, compact: true %>
              <% elsif song.nil? %>
                <%= link_to(take.job.pending? ? "Queued" : "Rendering", admin_generation_path(take.job), class: "sp-wait") %>
              <% elsif !take.in_set?(track) && track.origin_track_id && show.kind == "set" %>
                <% swap_params = { remix: 1, back: request.path } %>
                <% swap_params[:replaced] = take.replaced_stamp if take.rerender? %>
                <% swap_params[:song_id] = song.id unless take.rerender? %>
                <% choice = take.rerender? ? take.label.downcase : (take.original? ? "the original" : "remix #{take.number}") %>
                <%= button_to "Use", swap_admin_track_path(track), params: swap_params,
                      class: "btn-key btn-key-go", form: { class: "sp-use" },
                      data: { confirm: "Put #{choice} in the set and remix the set?" } %>
              <% end %>
            </li>
          <% end %>
        </ol>
        <% pending = pending_track_job_for(track.song) %>
        <% take_rendering = SongTakes.for(track.song).any? { |t| t.song.nil? && t.job&.live? } %>
        <% if pending && !take_rendering %>
          <%= render "admin/shared/track_job_loader", job: pending, compact: true %>
        <% end %>
        <% if track.song.votable? %>
          <p class="action-hint meta"><%= Admin::TrackJobsHelper::EDIT_HINT %></p>
          <%= form_tag rerender_admin_track_path(track), class: "rerender-form sp-remix" do %>
            <%= hidden_field_tag :back, request.path %>
            <input type="text" name="instructions" class="rerender-notes" maxlength="400" autocomplete="off"
                   placeholder="Slower, darker bass, no hi-hats, more space…">
            <button type="submit" class="btn-key btn-key-go">Edit</button>
          <% end %>
        <% end %>
        <% if track.song.prompt_log['payload'].present? %>
          <p class="action-hint meta"><%= Admin::TrackJobsHelper::REMIX_HINT %></p>
          <%= form_tag remix_admin_track_path(track), class: "rerender-form sp-remix" do %>
            <%= hidden_field_tag :back, request.path %>
            <input type="text" name="instructions" class="rerender-notes" maxlength="400" autocomplete="off"
                   placeholder="More vocal stabs, faster, add a 303 line…">
            <button type="submit" class="btn-key">Remix</button>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
