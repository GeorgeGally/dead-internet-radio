OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openrouter/free
ACE_STEP_URL=http://localhost:8001
GOOGLE_CLIENT_ID=

# Cheap paid model that screens listener requests (spots real bands).
REQUEST_FILTER_MODEL=anthropic/claude-haiku-5.5

# Emails that never run out of requests (testing).
REQUEST_LIMIT_EXEMPT=

# Listener emails ("your request airs Tue 23:40"), sent from the station's own
# domain. DreamHost: smtp.dreamhost.com, port 587, the mailbox's full address
# and password. Without SMTP_ADDRESS mail lands in tmp/mails.
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Dead Internet Radio <radio@example.com>
APP_URL=http://localhost:3000
# How far ahead the timeline is planned (and so how much notice an email gives).
STATION_HORIZON_HOURS=6
